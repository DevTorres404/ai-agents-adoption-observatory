# ============================================================
# Configuracion de Produccion - Observatorio IA
# Copiar a .env y completar secretos antes de desplegar
# ============================================================

# Entorno
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=observatorio_ia
DB_PORT=5432

# CORS
CORS_ORIGINS=https://ai.labtorres.me

# Swagger (deshabilitado en produccion)
SWAGGER_ENABLED=false

# Tokens
GITHUB_TOKEN=YOUR_GITHUB_TOKEN
